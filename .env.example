# Copy this file to `.env.local` and fill in real values for local dev.
# `.env.local` is gitignored; never commit secrets.

# Base URL for the FastAPI backend that the frontend should call.
# Vite-prefixed env vars (VITE_*) are exposed to client code via
# `import.meta.env.VITE_API_URL`.
VITE_API_URL=http://localhost:8000

# Optional: tag the build with the commit SHA / version (useful for
# debugging which build a user is on). Picked up automatically by
# vite when set.
# VITE_COMMIT_SHA=
# VITE_APP_VERSION=
